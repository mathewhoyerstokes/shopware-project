{% set product = page.product %}

<div class="sticky-buy-bar" data-sticky-buy-bar="true">
    <div class="sticky-buy-bar__inner">
        <div class="sticky-buy-bar__product">
            {% if product.cover.media.url %}
                <img class="sticky-buy-bar__image"
                     src="{{ product.cover.media.url }}"
                     alt="{{ product.translated.name }}">
            {% endif %}
            <div>
                <span class="sticky-buy-bar__name">{{ product.translated.name }}</span>
                <span class="sticky-buy-bar__number">{{ product.productNumber }}</span>
            </div>
        </div>

        <div class="sticky-buy-bar__actions">
            <div class="sticky-buy-bar__price">
                {{ product.calculatedPrice.unitPrice|currency }}
            </div>

            <form action="{{ path('frontend.checkout.line-item.add') }}"
                  method="post"
                  class="sticky-buy-bar__form">
                {{ sw_csrf('frontend.checkout.line-item.add') }}

                <input type="hidden" name="redirectTo" value="frontend.checkout.cart.page">
                <input type="hidden" name="lineItems[{{ product.id }}][id]" value="{{ product.id }}">
                <input type="hidden" name="lineItems[{{ product.id }}][type]" value="product">
                <input type="hidden" name="lineItems[{{ product.id }}][referencedId]" value="{{ product.id }}">

                <select name="lineItems[{{ product.id }}][quantity]" class="sticky-buy-bar__quantity">
                    {% for qty in 1..10 %}
                        <option value="{{ qty }}">{{ qty }}</option>
                    {% endfor %}
                </select>

                <button type="submit" class="sticky-buy-bar__submit">
                    Add to Cart
                </button>
            </form>
        </div>
    </div>
</div>
