{% set finderGroups = page.extensions.productFinderGroups %}

<div class="product-finder"
     data-product-finder="true"
     data-listing-url="{{ path('frontend.techzone.finder') }}">
    <div class="product-finder__header">
        <h3 class="product-finder__title">Find Your Perfect Matches</h3>
        <span class="product-finder__step" data-finder-step-indicator="true">Step 1 of 2</span>
    </div>

    <div class="product-finder__panel" data-finder-step="1">
        <p class="product-finder__question">What are you primarily looking for?</p>
        <div class="product-finder__options">
            {% for group in finderGroups %}
                <label class="product-finder__option">
                    <span class="product-finder__choice">
                        <input type="radio"
                               name="focus"
                               value="{{ group.id }}"
                               class="product-finder__radio"
                               data-finder-question="Which {{ group.translated.name }}?">
                        <span>{{ group.translated.name }}</span>
                    </span>
                    <span class="product-finder__arrow">&rarr;</span>
                </label>
            {% endfor %}
        </div>
    </div>

    <div class="product-finder__panel is-hidden" data-finder-step="2">
        <p class="product-finder__question" data-finder-question="true">Choose an option</p>
        {% for group in finderGroups %}
            <div class="product-finder__options is-hidden" data-finder-group="{{ group.id }}">
                {% for option in group.options %}
                    <label class="product-finder__option">
                        <span class="product-finder__choice">
                            <input type="radio"
                                   name="property"
                                   value="{{ option.id }}"
                                   class="product-finder__radio">
                            <span>{{ option.translated.name }}</span>
                        </span>
                        <span class="product-finder__arrow">&rarr;</span>
                    </label>
                {% endfor %}
            </div>
        {% endfor %}
    </div>

    <div class="product-finder__footer">
        <button type="button" class="product-finder__back is-hidden" data-finder-back="true">
            Back
        </button>
        <button type="button" class="product-finder__next" data-finder-next="true" disabled>
            Continue
        </button>
    </div>
</div>
