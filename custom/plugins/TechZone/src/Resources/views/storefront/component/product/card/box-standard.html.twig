{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{% block component_product_box_image %}
    <div class="product-quick-view-wrap">
        {{ parent() }}

        <button type="button"
                class="product-quick-view"
                data-quick-view-trigger="true"
                data-product-url="{{ seoUrl('frontend.detail.page', { 'productId': product.id }) }}">
            Quick View
        </button>
    </div>
{% endblock %}
