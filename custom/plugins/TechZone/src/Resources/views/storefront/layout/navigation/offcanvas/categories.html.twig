{% sw_extends '@Storefront/storefront/layout/navigation/offcanvas/categories.html.twig' %}

{% block layout_navigation_offcanvas_navigation_categories %}
    <div class="navigation-offcanvas-container js-navigation-offcanvas">
        <div class="navigation-offcanvas-overlay-content js-navigation-offcanvas-overlay-content">
            {% sw_include '@Storefront/storefront/layout/navigation/offcanvas/general-headline.html.twig' %}

            <ul class="list-unstyled navigation-offcanvas-list home-nav-cards">
                {% for item in navigation.tree %}
                    {% sw_include '@Storefront/storefront/layout/navigation/offcanvas/item-link.html.twig' with { item: item, activeId: navigation.active.id } %}
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
