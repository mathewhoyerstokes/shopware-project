{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_navigation_hotline %}{% endblock %}

{% block layout_footer_navigation_columns %}
    {% for root in page.footer.navigation.tree %}
        <div class="col-md-6 col-lg-3 footer-column js-footer-column">
            <div class="footer-column-headline footer-headline js-collapse-footer-column-trigger"
                 data-target="#collapseFooter{{ loop.index }}"
                 aria-expanded="true"
                 aria-controls="collapseFooter{{ loop.index }}">
                {{ root.category.translated.name }}
                <div class="footer-column-toggle">
                    <span class="footer-plus-icon">{% sw_icon 'plus' %}</span>
                    <span class="footer-minus-icon">{% sw_icon 'minus' %}</span>
                </div>
            </div>

            <div id="collapseFooter{{ loop.index }}"
                 class="footer-column-content collapse js-footer-column-content"
                 aria-labelledby="collapseFooterTitle{{ loop.index }}">
                <div class="footer-column-content-inner">
                    <ul class="list-unstyled">
                        {% for treeItem in root.children %}
                            {% set category = treeItem.category %}
                            {% set name = category.translated.name %}
                            {% set externalLink = category.translated.externalLink %}
                            <li class="footer-link-item">
                                <a class="footer-link"
                                   href="{% if externalLink %}{{ externalLink }}{% else %}{{ seoUrl('frontend.navigation.page', { navigationId: category.id }) }}{% endif %}"
                                   title="{{ name }}">
                                    {{ name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="col-md-6 col-lg-3 footer-column js-footer-column">
        <div class="footer-column-headline footer-headline js-collapse-footer-column-trigger"
             data-target="#collapseFooterNewsletter"
             aria-expanded="true"
             aria-controls="collapseFooterNewsletter">
            Newsletter
            <div class="footer-column-toggle">
                <span class="footer-plus-icon">{% sw_icon 'plus' %}</span>
                <span class="footer-minus-icon">{% sw_icon 'minus' %}</span>
            </div>
        </div>

        <div id="collapseFooterNewsletter"
             class="footer-column-content collapse js-footer-column-content">
            <div class="footer-column-content-inner">
                <div class="cms-block">
                    <div class="cms-element-form">
                        <form class="footer-newsletter"
                              action="{{ path('frontend.form.newsletter.register.handle') }}"
                              method="post">
                            {{ sw_csrf('frontend.form.newsletter.register.handle') }}
                            <input type="hidden" name="option" value="subscribe">
                            <input type="hidden" name="confirmationText" value="Check your email to confirm.">

                            <label class="footer-newsletter__label" for="footer-newsletter-email">Email address</label>
                            <input class="footer-newsletter__input"
                                   type="email"
                                   name="email"
                                   id="footer-newsletter-email"
                                   placeholder="Email address"
                                   required="required"
                                   autocomplete="email">
                            <button class="footer-newsletter__submit" type="submit">Sign up</button>
                            <input type="submit" class="submit--hidden d-none">

                            {% sw_include '@Storefront/storefront/component/captcha/base.html.twig' with {
                                captchas: shopware.config.core.basicInformation.activeCaptchas
                            } %}
                        </form>
                    </div>
                </div>

                <div class="footer-payment-logos">
                    <svg class="footer-payment-logos__visa" viewBox="0 0 48 32" role="img" aria-label="Visa">
                        <rect width="48" height="32" rx="4" fill="#fff"/>
                        <text x="24" y="21" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="14" font-style="italic" font-weight="700" fill="#1a1f71">VISA</text>
                    </svg>
                    <svg class="footer-payment-logos__mastercard" viewBox="0 0 48 32" role="img" aria-label="Mastercard">
                        <rect width="48" height="32" rx="4" fill="#fff"/>
                        <circle cx="20" cy="16" r="8" fill="#eb001b"/>
                        <circle cx="28" cy="16" r="8" fill="#f79e1b"/>
                        <path d="M24 9.4a8 8 0 0 1 0 13.2 8 8 0 0 1 0-13.2z" fill="#ff5f00"/>
                    </svg>
                    <svg class="footer-payment-logos__paypal" viewBox="0 0 64 32" role="img" aria-label="PayPal">
                        <rect width="64" height="32" rx="4" fill="#fff"/>
                        <text x="32" y="21" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="13" font-style="italic" font-weight="700">
                            <tspan fill="#003087">Pay</tspan><tspan fill="#009cde">Pal</tspan>
                        </text>
                    </svg>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block layout_footer_payment_shipping_logos %}{% endblock %}

{% block layout_footer_service_menu %}{% endblock %}

{% block layout_footer_vat %}{% endblock %}

{% block layout_footer_copyright %}{% endblock %}
