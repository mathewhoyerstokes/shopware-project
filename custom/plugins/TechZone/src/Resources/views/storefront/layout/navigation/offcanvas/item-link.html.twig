{% sw_extends '@Storefront/storefront/layout/navigation/offcanvas/item-link.html.twig' %}

{% block layout_navigation_offcanvas_navigation_categories_list_category_item_link %}
    <a class="home-nav-card navigation-offcanvas-link nav-item nav-link{% if isActive %} active{% endif %}"
       href="{{ url }}"
       itemprop="url"
       title="{{ name }}">
        {% sw_include '@Storefront/storefront/layout/navigation/category-card-image.html.twig' with {
            category: item.category,
            name: name
        } %}
        <span class="home-nav-card-name" itemprop="name">{{ name }}</span>
    </a>
{% endblock %}
