<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="TechZone\Content\Cms\HeroCmsElementResolver">
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="TechZone\Subscriber\ProductFinderSubscriber">
            <argument type="service" id="property_group.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="TechZone\Storefront\Controller\ProductFinderController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="property_group_option.repository"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
